// nautilus-core: the Rust half of nautilus-mcp.
//
// Swift owns the MCP server and the main loop; this library contributes the
// Android device controls. The surface is deliberately generic — a tool list
// and a call-by-name — so adding an Android primitive needs no .udl change and
// no regenerated bindings.

namespace nautilus_core {
    // PNG coding for the Swift side. It has ImageIO and cannot use it: on the
    // development machine ImageIO's codecs fault (SIGBUS, a poisoned 0xbad4007
    // function pointer) in any ordinary compiled binary, encode and decode
    // alike, while working inside Apple-signed hosts like xctest. Building a
    // CGImage from raw bytes and running Vision over it are unaffected, so only
    // the file codec has to come from here.
    [Throws=NautilusError]
    RawImage decode_png_base64(string base64_png);

    [Throws=NautilusError]
    string encode_png_base64(RawImage image);
};

// Uncompressed pixels, row-major RGBA8 — what CGImage can be built from
// directly, so Swift needs no decoder of its own.
dictionary RawImage {
    u32 width;
    u32 height;
    sequence<u8> rgba;
};

[Error]
enum NautilusError {
    "ConfigError",
    "InternalError",
};

// One tool, in the shape an MCP `tools/list` entry needs.
dictionary ToolSpec {
    string name;
    string description;
    // JSON Schema for the arguments, as a JSON string. Swift hands it to the
    // MCP client verbatim rather than re-modelling it.
    string input_schema;
};

dictionary ToolImage {
    string base64;
    string media_type;
};

// The result of a tool call: text, plus any images it produced.
dictionary ToolOutput {
    string text;
    sequence<ToolImage> images;
};

// A bound Android device. Construction resolves the device and fails with an
// explanation (none attached, unauthorized, ambiguous) rather than binding to
// nothing.
interface AndroidController {
    [Throws=NautilusError]
    constructor(string? serial);

    // The serial this controller is pinned to.
    string serial();

    // Every Android tool, for the MCP server's tools/list.
    sequence<ToolSpec> tools();

    // Invoke one by name. `args_json` is the MCP client's arguments object.
    [Throws=NautilusError]
    ToolOutput call(string name, string args_json);
};
